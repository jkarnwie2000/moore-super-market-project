# ---------------------------------------------------------------
# Moore Supermarket — environment configuration
# Copy this file to `.env` (in the project root) and fill in values.
# NEVER commit your real .env file.
# ---------------------------------------------------------------

# --- Stripe (https://dashboard.stripe.com/test/apikeys) ---
# Use TEST keys (sk_test_... / pk_test_...) during development.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` (local) or the webhook endpoint page in the Dashboard (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Safety switch: live keys (sk_live_...) are refused unless this is "true".
STRIPE_LIVE_MODE_ENABLED=false

# --- Database ---
# Leave empty in development to use a throwaway in-memory MongoDB (auto-seeded).
# Example: mongodb://127.0.0.1:27017/moore-supermarket  or a MongoDB Atlas URI
MONGODB_URI=

# --- App ---
# Where the React app is served (used for Stripe success/cancel redirects and CORS)
CLIENT_URL=http://localhost:5173
PORT=5000
# Long random string used to sign login tokens (required in production)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Store pricing (optional) ---
CURRENCY=usd
TAX_RATE=0.07
DELIVERY_FEE=7.99
FREE_DELIVERY_THRESHOLD=75
STORE_ADDRESS=Moore Supermarket, 1200 Market Street
# Sales reports group by day in this time zone; sizes at or below the threshold are "low stock"
STORE_TIMEZONE=America/New_York
LOW_STOCK_THRESHOLD=10

# --- Seed admin account (optional; used by `npm run seed`) ---
SEED_ADMIN_EMAIL=admin@mooresupermarket.com
SEED_ADMIN_PASSWORD=

# Email — order confirmations to shoppers, new-order alerts to the business, and password
# resets — sent through an ordinary mailbox over SMTP (no domain needed).
# Gmail: turn on 2-Step Verification, create an App password (myaccount.google.com/apppasswords),
# then put the Gmail address in SMTP_USER and the 16-letter app password in SMTP_PASS.
# Leave SMTP_USER/SMTP_PASS empty to switch email off (messages are printed to the server log).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=Moore Supermarket
# Where "New order" alerts go (defaults to SMTP_USER)
STORE_NOTIFY_EMAIL=
